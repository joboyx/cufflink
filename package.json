{
  "name": "cufflink",
  "version": "0.5.0",
  "private": true,
  "description": "Off-the-cuff sharing, buttoned-up links. Copy Jira, GitHub and GitLab links with their key and title, in one shortcut.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "wxt",
    "build": "wxt build",
    "clean": "rm -rf .output dist coverage .wxt",
    "fonts": "node scripts/copy-fonts.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky && wxt prepare",
    "start": "wxt",
    "test": "npm run lint && npm run type-coverage && npm run test:unit && npm run build",
    "test:unit": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "type-coverage": "type-coverage --project tsconfig.json --at-least 100",
    "zip": "wxt zip",
    "deploy": "npm run test && wxt zip"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "type-coverage": "^2.31.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "wxt": "^0.21.5"
  }
}
